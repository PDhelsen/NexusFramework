<?xml version="1.0" encoding="utf-8"?> 
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">

	<Type Name="NxFr::String">
		<Intrinsic Name="buffer" Expression="Capacity == 16 ? Data.Small : Data.Large" />
		<DisplayString>{ buffer(), s8 }</DisplayString>
		<StringView>buffer(), s8</StringView>
		<Expand>
			<Item Name="Size">Count</Item>
			<ArrayItems>
				<Size>Count + 1</Size>
				<ValuePointer>buffer()</ValuePointer>
			</ArrayItems>
		</Expand>
	</Type>

	<Type Name="NxFr::StringView">
		<DisplayString>{ Data, [Count]s8 }</DisplayString>
		<StringView>Data, [Count]s8</StringView>
		<Expand>
			<Item Name="Size">Count</Item>
			<ArrayItems>
				<Size>Count</Size>
				<ValuePointer>Data</ValuePointer>
			</ArrayItems>
		</Expand>
	</Type>

	<Type Name="NxFr::StringId">
		<DisplayString>{ Id }</DisplayString>
	</Type>
	
  <Type Name="NxFr::Array&lt;*&gt;">
		<Intrinsic Name="buffer" Expression="Count == $T2 ? Data.Stack: Data.Heap" />
		<DisplayString>{{ Count={Count} }}</DisplayString>
    <Expand>
      <ArrayItems>
        <Size>Count</Size>
				<ValuePointer>buffer()</ValuePointer>
			</ArrayItems>
    </Expand>
  </Type>
  
  <Type Name="NxFr::List&lt;*&gt;">
    <DisplayString>{{ Count={Count} }}</DisplayString>
    <Expand>
      <ArrayItems>
        <Size>Count</Size>
        <ValuePointer>Data</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <Type Name="NxFr::Dequeue&lt;*&gt;">
    <DisplayString>{{ size={Count} }}</DisplayString>
    <Expand>
      <IndexListItems>
        <Size>Count</Size>
        <ValueNode>Data[($i + IndexFront) / $T2][($i + IndexFront) % $T2]</ValueNode>
      </IndexListItems>
    </Expand>
  </Type>

  <Type Name="NxFr::Stack&lt;*&gt;">
    <DisplayString>{{ Count={Count} }}</DisplayString>
		<Expand>
			<IndexListItems>
				<Size>Count</Size>
				<ValueNode>Data[($i) / $T2][($i) % $T2]</ValueNode>
			</IndexListItems>
		</Expand>
  </Type>

  <Type Name="NxFr::Queue&lt;*&gt;">
    <DisplayString>{{ Count={Count} }}</DisplayString>
		<Expand>
			<IndexListItems>
				<Size>Count</Size>
				<ValueNode>Data[($i + IndexFront) / $T2][($i + IndexFront) % $T2]</ValueNode>
			</IndexListItems>
		</Expand>
  </Type>

	<Type Name="NxFr::LinkedList&lt;*&gt;">
		<DisplayString>{{ Count={Count} }}</DisplayString>
		<Expand>
			<LinkedListItems>
				<Size>Count</Size>
				<HeadPointer>DataHead</HeadPointer>
				<NextPointer>Next</NextPointer>
				<ValueNode>Value</ValueNode>
			</LinkedListItems>
		</Expand>
	</Type>
	
  <Type Name="NxFr::Set&lt;*&gt;">
		<DisplayString>{{ Count={Count} }}</DisplayString>
		<Expand>
			<CustomListItems>
				<Variable Name="Index" InitialValue="0" />

				<Size>Count</Size>
				<Loop>
					<If Condition="Data[Index].Hash != 0">
						<Item>Data[Index].Value</Item>
					</If>
					<Exec>Index++</Exec>
					<Break Condition="Index == Capacity" />
				</Loop>
			</CustomListItems>
		</Expand>
  </Type>

  <Type Name="NxFr::Dictionary&lt;*&gt;">
    <DisplayString>{{ Count={Count} }}</DisplayString>
		<Expand>
			<CustomListItems>
				<Variable Name="Index" InitialValue="0" />

				<Size>Count</Size>
				<Loop>
					<If Condition="Data[Index].Hash != 0">
						<Item>Data[Index].Value</Item>
					</If>
					<Exec>Index++</Exec>
					<Break Condition="Index == Capacity" />
				</Loop>
			</CustomListItems>
		</Expand>
  </Type>

  <Type Name="NxFr::Tree&lt;*&gt;">
    <DisplayString>{{ Count={Count} }}</DisplayString>
    <Expand>
      <TreeItems>
        <Size>Count</Size>
        <HeadPointer>Data</HeadPointer>
        <LeftPointer>Sibling</LeftPointer>
        <RightPointer>Child</RightPointer>
        <ValueNode>Value</ValueNode>
      </TreeItems>
    </Expand>
  </Type>

  <Type Name="NxFr::Graph&lt;*&gt;">
    <DisplayString>{{ Count={Count} }}</DisplayString>
    <Expand>
      <LinkedListItems>
        <Size>Count</Size>
        <HeadPointer>Data</HeadPointer>
        <NextPointer>Next</NextPointer>
        <ValueNode>Value</ValueNode>
      </LinkedListItems>
    </Expand>
  </Type>

	<Type Name="NxFr::Collection&lt;*&gt;::Wrapper&lt;*&gt;">
		<DisplayString>{ Iterator }</DisplayString>
		<Expand>
			<Item Name="Value">Iterator</Item>
		</Expand>
	</Type>

	<Type Name="NxFr::Pool&lt;*&gt;">
		<DisplayString>{{ Count={Data.Count} }}</DisplayString>
		<Expand>
			<Item Name="Data">Data</Item>
		</Expand>
	</Type>

	<Type Name="NxFr::Pooling::PreAllocated&lt;*&gt;">
		<DisplayString>{{ Count={Count} }}</DisplayString>
		<Expand>
			<CustomListItems>
				<Variable Name="Index" InitialValue="0" />

				<Size>Count</Size>
				<Loop>
					<If Condition="Data[Index].Next == 0">
						<Item>Data[Index].Value</Item>
					</If>
					<Exec>Index++</Exec>
					<Break Condition="Index == Capacity" />
				</Loop>
			</CustomListItems>
		</Expand>
	</Type>

	<Type Name="NxFr::Pooling::OnDemand&lt;*&gt;">
		<DisplayString>{{ Count={Count} }}</DisplayString>
		<Expand>
			<LinkedListItems>
				<Size>Count</Size>
				<HeadPointer>Data</HeadPointer>
				<NextPointer>Next</NextPointer>
				<ValueNode>Value</ValueNode>
			</LinkedListItems>
		</Expand>
	</Type>

	<Type Name="NxFr::Iterator::IteratorBlock&lt;*&gt;">
		<DisplayString>{ Data[Index] }</DisplayString>
		<Expand>
			<Item Name="Value">Data[Index]</Item>
		</Expand>
	</Type>

	<Type Name="NxFr::Iterator::IteratorBucket&lt;*&gt;">
		<DisplayString>{ Data[BucketIndex][DataIndex] }</DisplayString>
		<Expand>
			<Item Name="Value">Data[BucketIndex][DataIndex]</Item>
		</Expand>
	</Type>

	<Type Name="NxFr::Iterator::IteratorHashmap&lt;*&gt;">
		<DisplayString>{ Data[Index].Value }</DisplayString>
		<Expand>
			<Item Name="Value">Data[Index].Value</Item>
		</Expand>
	</Type>

	<Type Name="NxFr::Iterator::IteratorPreAllocated&lt;*&gt;">
		<DisplayString>{ Data[Index].Value }</DisplayString>
		<Expand>
			<Item Name="Value">Data[Index].Value</Item>
		</Expand>
	</Type>

	<Type Name="NxFr::Iterator::IteratorNodeSimple&lt;*&gt;">
		<DisplayString>{ Current->Value }</DisplayString>
		<Expand>
			<Item Name="Value">Current->Value</Item>
		</Expand>
	</Type>

	<Type Name="NxFr::Iterator::IteratorNodeDouble&lt;*&gt;">
		<DisplayString>{ Current->Value }</DisplayString>
		<Expand>
			<Item Name="Value">Current->Value</Item>
		</Expand>
	</Type>

	<Type Name="NxFr::Iterator::IteratorNodeTree&lt;*&gt;">
		<DisplayString>{ Current->Value }</DisplayString>
		<Expand>
			<Item Name="Value">Current->Value</Item>
		</Expand>
	</Type>

	<Type Name="NxFr::Iterator::IteratorNodeGraph&lt;*&gt;">
		<DisplayString>{ Current->Value }</DisplayString>
		<Expand>
			<Item Name="Value">Current->Value</Item>
		</Expand>
	</Type>

	<Type Name="NxFr::Handle&lt;*&gt;">
		<DisplayString>{ *(($T1*)(*(uint64*)(Pointer))) }</DisplayString>
		<Expand>
			<Item Name="Value">*(($T1*)(*(uint64*)(Pointer)))</Item>
		</Expand>
	</Type>

</AutoVisualizer>
