<?xml version="1.0" encoding="utf-8"?> 
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">

	<Type Name="NxEn::String">
		<Intrinsic Name="buffer" Expression="Capacity == SmallStringCapacity ? Data.Small : Data.Large" />
		<DisplayString>{ buffer(), s8 }</DisplayString>
		<StringView>buffer(), s8</StringView>
		<Expand>
			<Item Name="Size">Count</Item>
			<ArrayItems>
				<Size>Count + 1</Size>
				<ValuePointer>buffer()</ValuePointer>
			</ArrayItems>
		</Expand>
	</Type>

	<Type Name="NxEn::StringView">
		<DisplayString>{ Data, [Count]s8 }</DisplayString>
		<StringView>Data, [Count]s8</StringView>
		<Expand>
			<Item Name="Size">Count</Item>
			<ArrayItems>
				<Size>Count</Size>
				<ValuePointer>Data</ValuePointer>
			</ArrayItems>
		</Expand>
	</Type>

	<Type Name="NxEn::StringId">
		<DisplayString>{ Id }</DisplayString>
	</Type>
	
  <Type Name="NxEn::Array&lt;*&gt;">
    <DisplayString>{{ Count={Count} }}</DisplayString>
    <Expand>
      <ArrayItems>
        <Size>Count</Size>
        <ValuePointer>Data</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>
  
  <Type Name="NxEn::List&lt;*&gt;">
    <DisplayString>{{ Count={Count} }}</DisplayString>
    <Expand>
      <ArrayItems>
        <Size>Count</Size>
        <ValuePointer>Data</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <Type Name="NxEn::Dequeue&lt;*&gt;">
    <DisplayString>{{ size={Count} }}</DisplayString>
    <Expand>
      <IndexListItems>
        <Size>Count</Size>
        <ValueNode>Data[($i + IndexFront) / $T2][($i + IndexFront) % $T2]</ValueNode>
      </IndexListItems>
    </Expand>
  </Type>

  <Type Name="NxEn::Stack&lt;*&gt;">
    <DisplayString>{{ Count={Count} }}</DisplayString>
		<Expand>
			<IndexListItems>
				<Size>Count</Size>
				<ValueNode>Data[($i) / $T2][($i) % $T2]</ValueNode>
			</IndexListItems>
		</Expand>
  </Type>

  <Type Name="NxEn::Queue&lt;*&gt;">
    <DisplayString>{{ Count={Count} }}</DisplayString>
		<Expand>
			<IndexListItems>
				<Size>Count</Size>
				<ValueNode>Data[($i + IndexFront) / $T2][($i + IndexFront) % $T2]</ValueNode>
			</IndexListItems>
		</Expand>
  </Type>

	<Type Name="NxEn::LinkedList&lt;*&gt;">
		<DisplayString>{{ Count={Count} }}</DisplayString>
		<Expand>
			<LinkedListItems>
				<Size>Count</Size>
				<HeadPointer>DataHead</HeadPointer>
				<NextPointer>Next</NextPointer>
				<ValueNode>Value</ValueNode>
			</LinkedListItems>
		</Expand>
	</Type>
	
  <Type Name="NxEn::Set&lt;*&gt;">
		<DisplayString>{{ Count={Count} }}</DisplayString>
		<Expand>
			<CustomListItems>
				<Variable Name="Index" InitialValue="0" />

				<Size>Count</Size>
				<Loop>
					<If Condition="Data[Index].Free == false">
						<Item>Data[Index].Value</Item>
					</If>
					<Exec>Index++</Exec>
					<Break Condition="Index == Capacity" />
				</Loop>
			</CustomListItems>
		</Expand>
  </Type>

  <Type Name="NxEn::Dictionary&lt;*&gt;">
    <DisplayString>{{ Count={Count} }}</DisplayString>
		<Expand>
			<CustomListItems>
				<Variable Name="Index" InitialValue="0" />

				<Size>Count</Size>
				<Loop>
					<If Condition="Data[Index].Free == false">
						<Item>Data[Index].Value</Item>
					</If>
					<Exec>Index++</Exec>
					<Break Condition="Index == Capacity" />
				</Loop>
			</CustomListItems>
		</Expand>
  </Type>

  <Type Name="NxEn::Tree&lt;*&gt;">
    <DisplayString>{{ Count={Count} }}</DisplayString>
    <Expand>
      <TreeItems>
        <Size>Count</Size>
        <HeadPointer>Data</HeadPointer>
        <LeftPointer>Sibling</LeftPointer>
        <RightPointer>Child</RightPointer>
        <ValueNode>Value</ValueNode>
      </TreeItems>
    </Expand>
  </Type>

  <Type Name="NxEn::Graph&lt;*&gt;">
    <DisplayString>{{ Count={Count} }}</DisplayString>
    <Expand>
      <LinkedListItems>
        <Size>Count</Size>
        <HeadPointer>Data</HeadPointer>
        <NextPointer>Next</NextPointer>
        <ValueNode>Value</ValueNode>
      </LinkedListItems>
    </Expand>
  </Type>

  <Type Name="NxEn::Pool&lt;*&gt;">
    <DisplayString>{{ Count={Count} }}</DisplayString>
    <Expand>
      <LinkedListItems>
        <Size>Count</Size>
        <HeadPointer>Data</HeadPointer>
        <NextPointer>Next</NextPointer>
        <ValueNode>Value</ValueNode>
      </LinkedListItems>
    </Expand>
  </Type>

	<Type Name="NxEn::Collection&lt;*&gt;::Wrapper&lt;*&gt;">
		<DisplayString>{ Iterator }</DisplayString>
		<Expand>
			<Item Name="Value">Iterator</Item>
		</Expand>
	</Type>

	<Type Name="NxEn::IteratorBlock&lt;*&gt;">
		<DisplayString>{ Data[Index] }</DisplayString>
		<Expand>
			<Item Name="Value">Data[Index]</Item>
		</Expand>
	</Type>

	<Type Name="NxEn::IteratorBucket&lt;*&gt;">
		<DisplayString>{ Data[BucketIndex][DataIndex] }</DisplayString>
		<Expand>
			<Item Name="Value">Data[BucketIndex][DataIndex]</Item>
		</Expand>
	</Type>

	<Type Name="NxEn::IteratorHashmap&lt;*&gt;">
		<DisplayString>{ Current->Value }</DisplayString>
		<Expand>
			<Item Name="Value">Current->Value</Item>
		</Expand>
	</Type>

	<Type Name="NxEn::IteratorNodeSimple&lt;*&gt;">
		<DisplayString>{ Current->Value }</DisplayString>
		<Expand>
			<Item Name="Value">Current->Value</Item>
		</Expand>
	</Type>

	<Type Name="NxEn::IteratorNodeDouble&lt;*&gt;">
		<DisplayString>{ Current->Value }</DisplayString>
		<Expand>
			<Item Name="Value">Current->Value</Item>
		</Expand>
	</Type>

	<Type Name="NxEn::IteratorNodeTree&lt;*&gt;">
		<DisplayString>{ Current->Value }</DisplayString>
		<Expand>
			<Item Name="Value">Current->Value</Item>
		</Expand>
	</Type>

	<Type Name="NxEn::IteratorNodeGraph&lt;*&gt;">
		<DisplayString>{ Current->Value }</DisplayString>
		<Expand>
			<Item Name="Value">Current->Value</Item>
		</Expand>
	</Type>

</AutoVisualizer>
