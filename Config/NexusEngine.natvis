<?xml version="1.0" encoding="utf-8"?> 
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
  
  <Type Name="NxEn::Array&lt;*&gt;">
    <DisplayString>{{ Count={Count} }}</DisplayString>
    <Expand>
      <ArrayItems>
        <Size>Count</Size>
        <ValuePointer>Data</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>
  
  <Type Name="NxEn::List&lt;*&gt;">
    <DisplayString>{{ Count={Count} }}</DisplayString>
    <Expand>
      <ArrayItems>
        <Size>Count</Size>
        <ValuePointer>Data</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <Type Name="NxEn::Pool&lt;*&gt;">
    <DisplayString>{{ Count={Count} }}</DisplayString>
    <Expand>
      <LinkedListItems>
        <Size>Count</Size>
        <HeadPointer>Head</HeadPointer>
        <NextPointer>Next</NextPointer>
        <ValueNode>Data</ValueNode>
      </LinkedListItems>
    </Expand>
  </Type>

  <Type Name="NxEn::LinkedList&lt;*&gt;">
    <DisplayString>{{ Count={Count} }}</DisplayString>
    <Expand>
      <LinkedListItems>
        <Size>Count</Size>
        <HeadPointer>Head</HeadPointer>
        <NextPointer>Next</NextPointer>
        <ValueNode>Data</ValueNode>
      </LinkedListItems>
    </Expand>
  </Type>

  <Type Name="NxEn::Stack&lt;*&gt;">
    <DisplayString>{{ Count={Count} }}</DisplayString>
    <Expand>
      <LinkedListItems>
        <Size>Count</Size>
        <HeadPointer>Top</HeadPointer>
        <NextPointer>Next</NextPointer>
        <ValueNode>Data</ValueNode>
      </LinkedListItems>
    </Expand>
  </Type>

  <Type Name="NxEn::Queue&lt;*&gt;">
    <DisplayString>{{ Count={Count} }}</DisplayString>
    <Expand>
      <LinkedListItems>
        <Size>Count</Size>
        <HeadPointer>Head</HeadPointer>
        <NextPointer>Next</NextPointer>
        <ValueNode>Data</ValueNode>
      </LinkedListItems>
    </Expand>
  </Type>

  <Type Name="NxEn::Dequeue&lt;*&gt;">
    <DisplayString>{{ size={Count} }}</DisplayString>
    <Expand>
      <IndexListItems>
        <Size>Count</Size>
        <ValueNode>Data[($i + Front) / ChunkSize][($i + Front) % ChunkSize]</ValueNode>
      </IndexListItems>
    </Expand>
  </Type>

  <Type Name="NxEn::Graph&lt;*&gt;">
    <DisplayString>{{ Count={Count} }}</DisplayString>
    <Expand>
      <LinkedListItems>
        <Size>Count</Size>
        <HeadPointer>Root</HeadPointer>
        <NextPointer>Next</NextPointer>
        <ValueNode>Data</ValueNode>
      </LinkedListItems>
    </Expand>
  </Type>

  <Type Name="NxEn::Set&lt;*&gt;">
    <DisplayString>{{ Count={Count} }}</DisplayString>
    <Expand>
      <CustomListItems>
        <Variable Name="Index" InitialValue="0" />
        <Variable Name="Pointer" InitialValue="Data[0]" />
        
        <Size>Count</Size>
        <Loop>
          <If Condition="Pointer == nullptr">
            <Exec>Index++</Exec>
            <Break Condition="Index == Capacity" />
            <Exec>Pointer = Data[Index]</Exec>
          </If>
          <Else>
            <Item>Pointer->Value</Item>
            <Exec>Pointer = Pointer->Next</Exec>
          </Else>
        </Loop>
      </CustomListItems>
    </Expand>
  </Type>

</AutoVisualizer>